{
  "expo": {
    "name": "UnisSon",
    "slug": "UnisSon",
    "version": "0.3.3",
    "orientation": "portrait",
    "icon": "./assets/images/iconSketch.png",
    "scheme": "unisson",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/2b584c40-0ce1-4a6c-916d-cabc53e468a3"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.UnisSon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#dddddd",
        "foregroundImage": "./assets/images/iconSketch.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "package": "com.anonymous.UnisSon"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.643995195692-aeh67a1heqpat6k3shr17mpm72da6ll3"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/iconSketch.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#dddddd",
          "dark": {
            "backgroundColor": "#25292e"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "ALLOW ${PRODUCT_NAME} to ACCESS PICTURE NOW.",
          "savePhotosPermission": "ALLOW ${PRODUCT_NAME} to SAVE PICTURE NOW.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b584c40-0ce1-4a6c-916d-cabc53e468a3"
      }
    },
    "owner": "unissonsle"
  }
}
