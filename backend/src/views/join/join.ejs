<!DOCTYPE html>
<html>
<head>
    <title>Rejoindre <%= groupName %></title>
    <link rel="stylesheet" href="/index.css" />
</head>
<body>
    <div class="centered">
        <h1>Rejoindre <%= groupName %></h1>
        <a id="download" style="display:none" href="https://unisson.qbert.fr/">
            Télécharger, installer, exécuter et apprécier l'application
        </a>
        <script>
            window.location = "unisson://join/<%= token %>";
            
            setTimeout(() => {
                document.getElementById('download').style.display = 'block';
            }, 2500);
        </script>
    </div>
</body>
</html>